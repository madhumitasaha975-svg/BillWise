# Copy this file to `.env` (same folder) and edit. `.env` is git-ignored.

# --- Postgres (used by docker-compose) ---
POSTGRES_USER=billwise
POSTGRES_PASSWORD=billwise
POSTGRES_DB=billwise

# --- Backend ---
# Running the API on your own machine (outside Docker): host is localhost
DATABASE_URL=postgresql+asyncpg://billwise:billwise@localhost:5432/billwise
APP_ENV=development

