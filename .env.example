# ─────────────────────────────────────────────────────────────────────────────
# BillWise — Environment Variables Reference
# Copy this file to `.env` and fill in real values.
# NEVER commit .env with real secrets to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=billwise
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=billwise

# Full async DSN for SQLAlchemy.
# In Docker: host is the service name `db`, not `localhost`.
DATABASE_URL=postgresql+asyncpg://billwise:changeme_strong_password@db:5432/billwise

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=production          # development | production
SECRET_KEY=changeme_generate_with_openssl_rand_hex_32

# JWT token lifetimes (in minutes / days)
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Razorpay (Payment Gateway) ────────────────────────────────────────────────
# Leave blank to use the built-in FakePaymentGateway for local development
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Optional Observability ────────────────────────────────────────────────────
# SENTRY_DSN=https://...
